{
  "info": {
    "name": "GeoTrave-TEST",
    "description": "GeoTrave 多轮对话功能测试集。覆盖多对话线程、安全过滤、PII 脱敏。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "geotrave-dev"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Chat1-Step1 — 初始旅行需求",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', () => { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('status is success', () => { pm.expect(body.status).to.eql('success'); });",
              "pm.test('reply is non-empty', () => { pm.expect(body.reply).to.be.a('string').and.not.empty; });",
              "pm.test('session_id matches', () => { pm.expect(body.session_id).to.eql(pm.environment.get('chat1_session')); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"我想要去日本北海道玩个一周，但是我没有很多预算，差不多6000左右，不包括来回路费，我能过得比较舒适吗？可以规划吗？\",\n  \"session_id\": \"{{chat1_session}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/chat/",
          "host": ["{{base_url}}"],
          "path": ["chat"]
        }
      }
    },
    {
      "name": "Chat1-Step2 — 雪季时间追问",
